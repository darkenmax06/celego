generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERADOR
  FACTURACION
  MENSAJERO
}

enum CardStatus {
  DESPACHADA
  ENVIADA_INTERIOR
  EN_RUTA
  ACUSE_RECIBIDO
  DEVUELTA_TIENDA
  ENTREGA_DIGITAL
  ENTREGADA
  RETORNADA
  TD_ENTREGADO
  TD_DEVUELTO_NO_LOCALIZADO
  TD_NO_LE_INTERESA
  TD_RETIRADA_EN_OFICINA
  TD_SOLICITADA_POR_ERROR
  TD_ZONA_FUERA_COBERTURA
  NO_LOCALIZADO
  /// SDD contrato-tarjetas-pistoleo: digital delivery blocked on a missing (C) contract image.
  ENTREGA_DIGITAL_SIN_CONTRATO
  /// SDD contrato-tarjetas-pistoleo: physical delivery confirmed without the signed contract.
  ENTREGA_SIN_CONTRATO
  /// SDD solicitudes-reclamaciones-urgentes: card parked pending physical return receipt.
  EN_PROCESO_DE_RETORNO
}

enum UrgentCaseType {
  GENERAL
  SOLICITUD
  RECLAMACION
}

enum CardProductType {
  CREDITO
  DEBITO
}

enum DebitConsolidationRunStatus {
  VALIDATING
  READY
  PROCESSING
  COMPLETED
  FAILED
}

enum DebitConsolidationIssueSeverity {
  WARNING
  ROW_ERROR
  BLOCKING
}

enum RouteStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
}

enum DispatchOrigin {
  TORRE_POPULAR
  CENTRO_ACOPIO
  BPD_DEBITO
}

enum ImportBatchStatus {
  PROCESSING
  COMPLETED
  REJECTED
}

enum RedactionType {
  ENTREGA
  RETORNO
}

enum RedactionStatus {
  BORRADOR
  APROBADA
  ANULADA
}

enum MessengerServiceType {
  NORMAL
  REMOTA
  RECOGIDA
  MANDADO
}

enum SLAExtensionType {
  CEDULA
  REFERENCIA
}

enum MobileDeviceStatus {
  PENDING
  ACTIVE
  REVOKED
  LOST
}

enum MobileRoutePackageStatus {
  CREATED
  DOWNLOADED
  EXPIRED
  REVOKED
}

enum SecureEvidenceKind {
  ACUSE
  CEDULA
}

enum SecureEvidenceStatus {
  PENDING_RELAY
  UPLOADED_RELAY
  DOWNLOADED_CORE
  DECRYPTED
  REJECTED
  EXPIRED
}

enum MobileSyncJobKind {
  ROUTE_PACKAGE_DOWNLOAD
  EVIDENCE_UPLOAD
  EVIDENCE_PROCESSING
  INCIDENT_REPORT
  RETENTION_PURGE
  DEVICE_HEARTBEAT
}

enum MobileSyncJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  RETRY_SCHEDULED
  DEAD_LETTER
}

enum MobileIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MobileIncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CANCELED
}

/// Enforcement states for the card status transition graph.
enum CardTransitionPolicyMode {
  OFF
  SHADOW
  ENFORCE
}

/// Typed mirror of the confirmed Lot status values.
enum LotStatus {
  EN_TRANSITO
  PENDIENTE
}

/// Typed outcome mirror for route and lot item transitions.
enum ItemOutcome {
  EN_RUTA
  ACUSE_RECIBIDO
  DEVUELTA_TIENDA
}

model User {
  id                        String                     @id @default(cuid())
  name                      String
  email                     String                     @unique
  passwordHash              String
  role                      UserRole                   @default(OPERADOR)
  active                    Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  cardStatusLogs            CardStatusLog[]
  contactLogs               ContactLog[]
  approvedRedactions        Redaction[]                @relation("RedactionApprovedBy")
  createdRoutes             Route[]                    @relation("RouteCreatedBy")
  generatedMessengerReports MessengerReport[]          @relation("MessengerReportGeneratedBy")
  updatedSlaConfigs         SLAConfig[]                @relation("SlaConfigUpdatedBy")
  auditLogs                 AuditLog[]                 @relation("AuditActor")
  targetedAuditLogs         AuditLog[]                 @relation("AuditTargetUser")
  createdUrgentCases        UrgentCase[]               @relation("UrgentCaseCreatedBy")
  resolvedUrgentCases       UrgentCase[]               @relation("UrgentCaseResolvedBy")
  deliveryReassignments     CardDeliveryReassignment[] @relation("ReassignmentByUser")
  workflowDrafts            WorkflowDraft[]
  generatedBizcochitos      BizcochitoBatch[]          @relation("BizcochitoGeneratedBy")
  createdDebitConsolidations DebitConsolidationRun[]    @relation("DebitConsolidationCreatedBy")
  reportedMobileIncidents   MobileIncident[]           @relation("MobileIncidentCreatedBy")
  updatedCardTransitionPolicies CardTransitionPolicy[]  @relation("CardTransitionPolicyUpdatedBy")
  viewPreferences            UserViewPreference[]
  savedFilters               UserSavedFilter[]
  updatedDebitConsolidadoExportConfigs DebitConsolidadoExportConfig[] @relation("DebitConsolidadoExportConfigUpdatedBy")
  updatedScriptConfigs       OperativeScriptConfig[]    @relation("ScriptConfigUpdatedBy")
  requestedSlaExtensions     SLAExtensionRequest[]      @relation("SlaExtensionRequestedBy")
  approvedSlaExtensions      SLAExtensionRequest[]      @relation("SlaExtensionApprovedBy")
  createdCardGroups          CardGroup[]                @relation("CardGroupCreatedBy")
  addedCardGroupMembers      CardGroupMember[]          @relation("CardGroupMemberAddedBy")
}

model Customer {
  id           String   @id @default(cuid())
  cedula       String   @unique
  nombre       String
  telefonosRaw String?
  direccionRaw String?
  provincia    String?
  zona         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cards        Card[]
}

model Card {
  id                    String                     @id @default(cuid())
  tc                    String
  requestNumber         String?
  productType           CardProductType            @default(CREDITO)
  externalReference     String?
  dispatchOrigin        DispatchOrigin?
  sourceRecordKey       String?                    @unique
  sourceTerminal        String?
  importBatchId         String?
  importBatch           CardImportBatch?           @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  customerId            String
  customer              Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  zona                  String
  provincia             String
  dispatchDate          DateTime?
  deliveryType          String?
  emissionType          String?
  supplier              String?
  contractType          String?
  status                CardStatus                 @default(DESPACHADA)
  isRemote              Boolean                    @default(false)
  isAdditional          Boolean                    @default(false)
  additionalIndex       Int                        @default(0)
  urgent                Boolean                    @default(false)
  slaDueDate            DateTime?
  slaExtensionDays      Int                        @default(0)
  returnReason          String?
  currentMessengerId    String?
  currentMessenger      Messenger?                 @relation("CurrentMessengerCards", fields: [currentMessengerId], references: [id], onDelete: SetNull)
  lastAssignedMessengerId String?
  lastAssignedMessenger Messenger?                 @relation("LastAssignedMessengerCards", fields: [lastAssignedMessengerId], references: [id], onDelete: SetNull)
  reassignedProvince    String?
  reassignedZone        String?
  reassignedAt          DateTime?
  reassignedMessengerId String?
  reassignedMessenger   Messenger?                 @relation("ReassignedMessengerCards", fields: [reassignedMessengerId], references: [id], onDelete: SetNull)
  digitalDeliveryCycle  Int                        @default(0)
  bizcochito            Boolean                    @default(false)
  bizcochitoAt          DateTime?
  /// SDD contrato-tarjetas-pistoleo: whether this card requires a signed contract.
  hasContract           Boolean                    @default(false)
  /// SDD contrato-tarjetas-pistoleo: when the (C) contract image was recorded.
  contractImageAt       DateTime?
  /// SDD contrato-tarjetas-pistoleo: original filename of the recorded contract image.
  contractImageFile     String?
  /// SDD solicitudes-reclamaciones-urgentes: historical flag, set true on first SOLICITUD case, never cleared.
  hadSolicitud          Boolean                    @default(false)
  /// SDD solicitudes-reclamaciones-urgentes: historical flag, set true on first RECLAMACION case, never cleared.
  hadReclamacion        Boolean                    @default(false)
  metadata              Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  logs                  CardStatusLog[]
  routeItems            RouteItem[]
  redactionItems        RedactionItem[]
  contacts              ContactLog[]
  lotItems              LotItem[]
  urgentCases           UrgentCase[]
  deliveryReassignments CardDeliveryReassignment[]
  bizcochitoItems       BizcochitoItem[]
  debitStatusEvents     DebitStatusEvent[]
  secureEvidences       SecureEvidence[]
  importRows            CardImportRow[]
  originQuarantines     DispatchOriginQuarantine[]
  slaExtensionRequests  SLAExtensionRequest[]
  groupMemberships      CardGroupMember[]

  @@index([tc])
  @@index([requestNumber])
  @@index([productType, requestNumber])
  @@index([productType, status, slaDueDate])
  @@index([productType, dispatchDate])
  @@index([dispatchOrigin, dispatchDate])
  @@index([importBatchId])
  @@index([status])
  @@index([provincia, zona])
  @@index([status, bizcochito, digitalDeliveryCycle])
  @@index([customerId, dispatchDate, additionalIndex])
  @@index([isAdditional])
  @@index([hasContract, status])
  @@index([urgent, status])
}

/// SDD solicitudes-reclamaciones-urgentes (D6): shared card selection group, visible to every operator, no owner scoping on edit/delete.
model CardGroup {
  id          String            @id @default(cuid())
  name        String            @unique
  createdById String?
  createdBy   User?             @relation("CardGroupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     CardGroupMember[]
}

/// SDD solicitudes-reclamaciones-urgentes (D6): membership targets Card (not UrgentCase) so a group survives case resolution.
model CardGroupMember {
  groupId   String
  group     CardGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  addedById String?
  addedBy   User?     @relation("CardGroupMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  addedAt   DateTime  @default(now())

  @@id([groupId, cardId])
  @@index([cardId])
}

model DispatchOriginQuarantine {
  id         String    @id @default(cuid())
  cardId     String    @unique
  card       Card      @relation(fields: [cardId], references: [id], onDelete: Restrict)
  reason     String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt, createdAt])
}

model CardImportBatch {
  id            String            @id @default(cuid())
  origin        DispatchOrigin
  originalName  String
  sha256        String            @unique
  status        ImportBatchStatus @default(PROCESSING)
  rowCount      Int               @default(0)
  createdCount  Int               @default(0)
  updatedCount  Int               @default(0)
  skippedCount  Int               @default(0)
  rejectedCount Int               @default(0)
  label         String?
  importedById  String?
  createdAt     DateTime          @default(now())
  completedAt   DateTime?
  cards         Card[]
  rows          CardImportRow[]

  @@index([origin, createdAt])
}

model CardImportRow {
  id        String          @id @default(cuid())
  batchId   String
  batch     CardImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  cardId    String?
  card      Card?           @relation(fields: [cardId], references: [id], onDelete: SetNull)
  sourceRow Int
  sourceKey String
  outcome   String
  reason    String?
  createdAt DateTime        @default(now())

  @@unique([batchId, sourceRow])
  @@index([sourceKey])
}

model CardTcGuard {
  tc              String   @id
  activeCardId    String?  @unique
  deliveredCardId String?  @unique
  updatedAt       DateTime @updatedAt
}

model CardStatusLog {
  id         String      @id @default(cuid())
  cardId     String
  card       Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fromStatus CardStatus?
  toStatus   CardStatus
  note       String?
  byUserId   String?
  byUser     User?       @relation(fields: [byUserId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([cardId, createdAt])
}

model Messenger {
  id                String                     @id @default(cuid())
  nombre            String
  telefono          String?
  zonaPrincipal     String?
  provinciaTrabajo  String?
  activo            Boolean                    @default(true)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  serviceRates      MessengerServiceRate[]
  dailyRecords      MessengerDailyRecord[]
  routes            Route[]
  currentCards      Card[]                     @relation("CurrentMessengerCards")
  lastAssignedCards Card[]                     @relation("LastAssignedMessengerCards")
  reassignedCards   Card[]                     @relation("ReassignedMessengerCards")
  reassignmentsFrom CardDeliveryReassignment[] @relation("ReassignmentFromMessenger")
  reassignmentsTo   CardDeliveryReassignment[] @relation("ReassignmentToMessenger")
  reports           MessengerReport[]
  mobileDevices     MobileDevice[]
  mobilePackages    MobileRoutePackage[]
  secureEvidences   SecureEvidence[]
  mobileIncidents   MobileIncident[]
  mobileSyncJobs    MobileSyncJob[]
}

model DebitConsolidationRun {
  id                   String                       @id @default(cuid())
  status               DebitConsolidationRunStatus  @default(VALIDATING)
  validationToken      String                       @unique
  dispatchDate         DateTime
  baseFileName         String
  baseFileSha256       String
  baseFile             Bytes
  newCardsFileName     String?
  newCardsFileSha256   String?
  newCardsFile         Bytes?
  statusFileName       String?
  statusFileSha256     String?
  statusFile           Bytes?
  outputFileName       String?
  outputFile           Bytes?
  counts               Json?
  errorMessage         String?
  createdById          String?
  createdBy            User?                        @relation("DebitConsolidationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  appliedAt            DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  issues               DebitConsolidationIssue[]
  statusEvents         DebitStatusEvent[]

  @@index([status, createdAt])
  @@index([baseFileSha256])
}

model DebitConsolidationIssue {
  id            String                          @id @default(cuid())
  runId         String
  run           DebitConsolidationRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceFile    String
  sheet         String?
  rowNumber     Int?
  requestNumber String?
  severity      DebitConsolidationIssueSeverity
  code          String
  message       String
  createdAt     DateTime                        @default(now())

  @@index([runId, severity])
  @@index([requestNumber])
}

model DebitStatusEvent {
  id             String                 @id @default(cuid())
  runId          String
  run            DebitConsolidationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  cardId         String?
  card           Card?                  @relation(fields: [cardId], references: [id], onDelete: SetNull)
  requestNumber  String
  trackingNumber String?
  externalStatus String
  movementAt     DateTime?
  operator       String?
  notes          String?
  resolution     Json?
  createdAt      DateTime               @default(now())

  @@index([cardId, movementAt])
  @@index([requestNumber, movementAt])
}

model MessengerServiceRate {
  id          String               @id @default(cuid())
  messengerId String
  messenger   Messenger            @relation(fields: [messengerId], references: [id], onDelete: Cascade)
  serviceType MessengerServiceType
  amountCents Int

  @@unique([messengerId, serviceType])
}

model MessengerDailyRecord {
  id               String    @id @default(cuid())
  messengerId      String
  messenger        Messenger @relation(fields: [messengerId], references: [id], onDelete: Cascade)
  fecha            DateTime
  entregasNormales Int       @default(0)
  entregasRemotas  Int       @default(0)
  recogidasBanco   Int       @default(0)
  mandados         Int       @default(0)
  totalCents       Int       @default(0)
  notas            String?
  createdAt        DateTime  @default(now())

  @@index([messengerId, fecha])
}

model MessengerReport {
  id            String    @id @default(cuid())
  messengerId   String
  messenger     Messenger @relation(fields: [messengerId], references: [id], onDelete: Cascade)
  fromDate      DateTime
  toDate        DateTime
  generatedAt   DateTime  @default(now())
  generatedById String?
  generatedBy   User?     @relation("MessengerReportGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  totalCents    Int       @default(0)
  imagePath     String?
  anulada       Boolean   @default(false)
}

model Route {
  id              String               @id @default(cuid())
  fecha           DateTime
  messengerId     String
  messenger       Messenger            @relation(fields: [messengerId], references: [id], onDelete: Restrict)
  status          RouteStatus          @default(PENDIENTE)
  notas           String?
  createdById     String?
  createdBy       User?                @relation("RouteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  items           RouteItem[]
  mobilePackages  MobileRoutePackage[]
  secureEvidences SecureEvidence[]
  mobileIncidents MobileIncident[]
  mobileSyncJobs  MobileSyncJob[]

  @@index([fecha, messengerId])
}

model RouteItem {
  id              String           @id @default(cuid())
  routeId         String
  route           Route            @relation(fields: [routeId], references: [id], onDelete: Cascade)
  cardId          String
  card            Card             @relation(fields: [cardId], references: [id], onDelete: Restrict)
  sequence        Int              @default(0)
  checkedAt       DateTime?
  secureEvidences SecureEvidence[]
  mobileIncidents MobileIncident[]
  mobileSyncJobs  MobileSyncJob[]
  /// Typed outcome mirror; checkedAt remains the legacy write path.
  outcome       ItemOutcome?
  outcomeReason String?
  outcomeAt     DateTime?

  @@unique([routeId, cardId])
}

model MobileDevice {
  id                     String               @id @default(cuid())
  deviceId               String               @unique
  label                  String?
  platform               String               @default("ANDROID")
  status                 MobileDeviceStatus   @default(PENDING)
  messengerId            String?
  messenger              Messenger?           @relation(fields: [messengerId], references: [id], onDelete: SetNull)
  publicKey              String?
  certificateFingerprint String?              @unique
  lastSeenAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  mobilePackages         MobileRoutePackage[]
  secureEvidences        SecureEvidence[]
  mobileIncidents        MobileIncident[]
  mobileSyncJobs         MobileSyncJob[]

  @@index([messengerId, status])
  @@index([status, updatedAt])
}

model MobileRoutePackage {
  id             String                   @id @default(cuid())
  packageId      String                   @unique
  routeId        String
  route          Route                    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  messengerId    String
  messenger      Messenger                @relation(fields: [messengerId], references: [id], onDelete: Restrict)
  mobileDeviceId String?
  mobileDevice   MobileDevice?            @relation(fields: [mobileDeviceId], references: [id], onDelete: SetNull)
  deliveryDate   DateTime
  expiresAt      DateTime
  status         MobileRoutePackageStatus @default(CREATED)
  manifest       Json
  downloadedAt   DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([messengerId, deliveryDate])
  @@index([mobileDeviceId, expiresAt])
  @@index([status, expiresAt])
}

model SecureEvidence {
  id                     String               @id @default(cuid())
  deliveryId             String               @unique
  objectId               String               @unique
  evidenceKind           SecureEvidenceKind
  routeId                String?
  route                  Route?               @relation(fields: [routeId], references: [id], onDelete: SetNull)
  routeItemId            String?
  routeItem              RouteItem?           @relation(fields: [routeItemId], references: [id], onDelete: SetNull)
  cardId                 String?
  card                   Card?                @relation(fields: [cardId], references: [id], onDelete: SetNull)
  messengerId            String
  messenger              Messenger            @relation(fields: [messengerId], references: [id], onDelete: Restrict)
  deviceId               String
  mobileDeviceId         String?
  mobileDevice           MobileDevice?        @relation(fields: [mobileDeviceId], references: [id], onDelete: SetNull)
  status                 SecureEvidenceStatus @default(PENDING_RELAY)
  sha256                 String
  byteSize               Int
  encryptionAlgorithm    String               @default("AES-256-GCM")
  keyEncryptionAlgorithm String               @default("RSA-OAEP-SHA256")
  encryptedKey           String
  nonce                  String
  authTag                String
  capturedAt             DateTime
  uploadedAt             DateTime?
  relayReceivedAt        DateTime?
  coreDownloadedAt       DateTime?
  decryptedAt            DateTime?
  expiresAt              DateTime?
  manifest               Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  mobileSyncJobs         MobileSyncJob[]

  @@index([messengerId, capturedAt])
  @@index([deviceId, status])
  @@index([mobileDeviceId, status])
  @@index([cardId])
  @@index([routeItemId])
  @@index([status, expiresAt])
}

model MobileIncident {
  id              String                 @id @default(cuid())
  incidentId      String                 @unique
  severity        MobileIncidentSeverity @default(MEDIUM)
  status          MobileIncidentStatus   @default(OPEN)
  type            String
  title           String
  description     String?
  deviceId        String
  mobileDeviceId  String?
  mobileDevice    MobileDevice?          @relation(fields: [mobileDeviceId], references: [id], onDelete: SetNull)
  messengerId     String?
  messenger       Messenger?             @relation(fields: [messengerId], references: [id], onDelete: SetNull)
  routeId         String?
  route           Route?                 @relation(fields: [routeId], references: [id], onDelete: SetNull)
  routeItemId     String?
  routeItem       RouteItem?             @relation(fields: [routeItemId], references: [id], onDelete: SetNull)
  cardId          String?
  evidenceObjectId String?
  gps             Json?
  metadata        Json?
  reportedAt      DateTime
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  resolutionNote  String?
  createdByUserId String?
  createdByUser   User?                  @relation("MobileIncidentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  syncJobs        MobileSyncJob[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status, severity, reportedAt])
  @@index([deviceId, reportedAt])
  @@index([messengerId, status])
  @@index([routeItemId])
}

model MobileSyncJob {
  id               String              @id @default(cuid())
  kind             MobileSyncJobKind
  status           MobileSyncJobStatus @default(PENDING)
  deviceId         String?
  mobileDeviceId   String?
  mobileDevice     MobileDevice?       @relation(fields: [mobileDeviceId], references: [id], onDelete: SetNull)
  messengerId      String?
  messenger        Messenger?          @relation(fields: [messengerId], references: [id], onDelete: SetNull)
  routeId          String?
  route            Route?              @relation(fields: [routeId], references: [id], onDelete: SetNull)
  routeItemId      String?
  routeItem        RouteItem?          @relation(fields: [routeItemId], references: [id], onDelete: SetNull)
  secureEvidenceId String?
  secureEvidence   SecureEvidence?     @relation(fields: [secureEvidenceId], references: [id], onDelete: SetNull)
  incidentId       String?
  incident         MobileIncident?     @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  objectId         String?
  attempts         Int                 @default(0)
  maxAttempts      Int                 @default(5)
  nextRunAt        DateTime            @default(now())
  lastError        String?
  payload          Json?
  completedAt      DateTime?
  attemptsLog      MobileSyncAttempt[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, nextRunAt])
  @@index([kind, status])
  @@index([deviceId, status])
  @@index([secureEvidenceId])
  @@index([incidentId])
}

model MobileSyncAttempt {
  id            String              @id @default(cuid())
  jobId         String
  job           MobileSyncJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attemptNumber Int
  status        MobileSyncJobStatus
  error         String?
  details       Json?
  createdAt     DateTime            @default(now())

  @@index([jobId, createdAt])
}

model ContactLog {
  id              String   @id @default(cuid())
  cardId          String
  card            Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  telefonosUsados String?
  comentario      String?
  contactado      Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([cardId, createdAt])
}

model Redaction {
  id             String          @id @default(cuid())
  tipo           RedactionType
  dispatchOrigin DispatchOrigin?
  status         RedactionStatus @default(BORRADOR)
  zona           String
  fecha          DateTime
  notas          String?
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?           @relation("RedactionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  anulada        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  items          RedactionItem[]

  @@index([fecha, tipo, zona])
  @@index([fecha, tipo, dispatchOrigin, zona])
}

model RedactionItem {
  id            String     @id @default(cuid())
  redactionId   String
  redaction     Redaction  @relation(fields: [redactionId], references: [id], onDelete: Cascade)
  cardId        String
  card          Card       @relation(fields: [cardId], references: [id], onDelete: Restrict)
  comentario    String?
  appliedStatus CardStatus
  isRemote      Boolean?
  sequence      Int        @default(0)
  createdAt     DateTime   @default(now())

  @@unique([redactionId, cardId])
  @@index([redactionId, sequence])
}

model CardDeliveryReassignment {
  id                String     @id @default(cuid())
  cardId            String
  card              Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fromProvince      String
  fromZone          String
  fromMessengerId   String?
  fromMessenger     Messenger? @relation("ReassignmentFromMessenger", fields: [fromMessengerId], references: [id], onDelete: SetNull)
  fromMessengerName String?
  toProvince        String
  toZone            String
  toMessengerId     String
  toMessenger       Messenger  @relation("ReassignmentToMessenger", fields: [toMessengerId], references: [id], onDelete: Restrict)
  toMessengerName   String
  note              String?
  byUserId          String?
  byUser            User?      @relation("ReassignmentByUser", fields: [byUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())

  @@index([cardId, createdAt])
}

model WorkflowDraft {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     String
  contextKey String   @default("default")
  payload    Json
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, module, contextKey])
  @@index([userId, updatedAt])
}

model UrgentCase {
  id                 String         @id @default(cuid())
  cardId             String?
  card               Card?          @relation(fields: [cardId], references: [id], onDelete: SetNull)
  tc                 String
  cedula             String
  provincia          String?
  telefono           String?
  status             String?
  direccion          String?
  level              Int            @default(1)
  createdById        String?
  createdBy          User?          @relation("UrgentCaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedAt         DateTime?
  resolvedById       String?
  resolvedBy         User?          @relation("UrgentCaseResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  lastNotifiedAt     DateTime?
  nextNotificationAt DateTime?
  importedAt         DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  /// SDD solicitudes-reclamaciones-urgentes (D1): discriminates legacy GENERAL cases from the new case types.
  caseType           UrgentCaseType @default(GENERAL)
  /// SDD solicitudes-reclamaciones-urgentes (D1): SOLICITUD-only promoted column, filterable/sortable in UI.
  ticket             String?
  /// SDD solicitudes-reclamaciones-urgentes (D1): SOLICITUD-only promoted column.
  etapa              String?
  /// SDD solicitudes-reclamaciones-urgentes (D1): SOLICITUD-only promoted column.
  analista           String?
  /// SDD solicitudes-reclamaciones-urgentes (D1): type-specific fields validated by lib/urgent-case-details.ts, re-emitted verbatim into the response export.
  details            Json?

  @@index([cedula])
  @@index([tc])
  @@index([cardId, resolvedAt])
  @@index([nextNotificationAt, resolvedAt])
  @@index([level, resolvedAt])
  @@index([caseType, resolvedAt])
  @@index([ticket])
}

model Lot {
  id           String     @id @default(cuid())
  lotNumber    String     @unique
  enviadoA     String
  sentTo       String?
  fechaEnvio   DateTime
  fechaRetorno DateTime?
  estatus      String
  /// Typed mirror of `estatus` (SDD `rutas-lotes-redesign`, Slice 3, task 3.1).
  /// Nullable/additive; `estatus` keeps being written unchanged. Dual-written
  /// by every current `estatus` writer (Lot creation, `UPDATE_LOT_STATUS`, and
  /// the `/api/importaciones/lotes` bulk upsert); left null (report-and-skip)
  /// when the free-text value has no mapping in `LotStatus` — see that enum's
  /// doc comment for why it is deliberately minimal.
  estatusTipo  LotStatus?
  notas        String?
  createdAt    DateTime   @default(now())
  items        LotItem[]
}

model LotItem {
  id            String       @id @default(cuid())
  lotId         String
  lot           Lot          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  cardId        String?
  card          Card?        @relation(fields: [cardId], references: [id], onDelete: SetNull)
  tc            String
  cedula        String?
  telefono      String?
  recibida      String?
  retornada     String?
  /// Typed mirror columns (SDD `rutas-lotes-redesign`, Slice 3, task 3.1).
  /// `recibidaAt`/`retornadaAt` are dual-written by `applyLotItemResult`
  /// alongside the legacy `recibida`/`retornada` strings above (nullable,
  /// additive; the legacy columns keep being written unchanged). `outcome`/
  /// `outcomeReason` are schema-only in this batch — no writer populates them
  /// yet (Slice 4b's `applyItemOutcome`).
  outcome       ItemOutcome?
  outcomeReason String?
  recibidaAt    DateTime?
  retornadaAt   DateTime?

  @@index([tc])
}

model ZoneTariff {
  id        String            @id @default(cuid())
  zona      String            @unique
  baseCents Int               @default(0)
  active    Boolean           @default(true)
  ranges    ZoneTariffRange[]
}

model ZoneTariffRange {
  id           String     @id @default(cuid())
